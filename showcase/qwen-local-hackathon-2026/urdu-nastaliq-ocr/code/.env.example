# Copy to .env and fill in what you need. Never commit .env.

# Hugging Face token: optional, gives faster/rate-limit-free downloads.
# https://huggingface.co/settings/tokens (read access)
HF_TOKEN=

# Anthropic key: optional, only for the Claude baseline in eval
# (python -m uocr.eval.evaluate --backend claude). Or run `ant auth login`.
ANTHROPIC_API_KEY=

# Web app
UOCR_BASE_MODEL=Qwen/Qwen3-VL-2B-Instruct
UOCR_ADAPTER_PATH=outputs/qwen3vl2b-urdu-ocr-lora
# 1 = fake model, for UI work without a GPU
UOCR_MOCK=0

# Tesseract baseline: folder holding urd.traineddata, if you can't write to the install's tessdata
# (e.g. no admin rights on Windows). Leave empty to use Tesseract's default.
# TESSDATA_PREFIX=E:\Models\tessdata
